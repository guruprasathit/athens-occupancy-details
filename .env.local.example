# Google Sheets Integration
# 1. Go to https://console.cloud.google.com
# 2. Create a project → Enable "Google Sheets API"
# 3. IAM & Admin → Service Accounts → Create → Download JSON key
# 4. Base64-encode the JSON: run:  python -c "import base64,open;print(base64.b64encode(open('key.json','rb').read()).decode())"
# 5. Share your Google Sheet with the service account email (Editor access)

GOOGLE_SERVICE_ACCOUNT_KEY=<base64-encoded-service-account-json>
GOOGLE_SHEET_ID=<your-google-sheet-id-from-url>
